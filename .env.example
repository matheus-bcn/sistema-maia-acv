# Supabase — obtenha em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Necessário para ações administrativas (criar/remover login de vendedores)
# Nunca exponha esta chave no client — use apenas em Server Actions/Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Autenticação — false permite acessar o app sem login (usa as policies de dev no schema)
NEXT_PUBLIC_REQUIRE_AUTH=false

# E-mail com privilégios de admin garantidos independentemente da flag is_admin no banco
MASTER_ADMIN_EMAIL=

# IA (M.A.I.A) — https://console.groq.com
GROQ_API_KEY=

# Webhook de novas vendas (app/api/webhooks/sales)
WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
